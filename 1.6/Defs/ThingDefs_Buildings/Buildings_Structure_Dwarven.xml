<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ThingDef ParentName="BuildingBase">
		<defName>DV_Dwarven_HallPillar</defName>
		<label>hall pillar</label>
		<description>A large, dwarven pillar capable of holding a roof. Does not block sight or movement and looks quite nice.</description>
		<designationCategory>Structure</designationCategory>
		<canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
		<altitudeLayer>Building</altitudeLayer>
		<uiOrder>2040</uiOrder>
		<blockLight>false</blockLight>
		<passability>PassThroughOnly</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<fillPercent>0.75</fillPercent>
		<pathCost>0</pathCost>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>1550</WorkToBuild>
			<Mass>30</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
		</statBases>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<holdsRoof>true</holdsRoof>
		<canOverlapZones>false</canOverlapZones>
		<rotatable>false</rotatable>
		<fertility>0</fertility>
		<specialDisplayRadius>6.9</specialDisplayRadius>		<!-- must be kept in sync with roof hold-up radius -->
		<building>
			<isInert>true</isInert>
			<ai_chillDestination>false</ai_chillDestination>
			<paintable>true</paintable>
		</building>
		<size>(1,1)</size>
		<uiIconScale>0.5</uiIconScale>
		<graphicData>
			<drawSize>(3,3)</drawSize>
			<drawOffset>(0,0,1)</drawOffset>
			<texPath>Things/Building/Furniture/HallPillar</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<shadowData>
				<volume>(1, 1, 1)</volume>
				<offset>(0,0,-0.23)</offset>
			</shadowData>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
	</ThingDef>

	<ThingDef ParentName="DoorBase">
		<defName>DV_HallDoor</defName>
		<label>hall door</label>
		<description>Divides rooms. An etched stone door decorated in a dwarven style. This large, heavy door requires adjacent walls to function.</description>
		<thingClass>Building_MultiTileDoor</thingClass>
		<dominantStyleCategory>DV_Dwarven</dominantStyleCategory>
		<canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
		<statBases>
			<WorkToBuild>15000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Beauty>30</Beauty>
		</statBases>
		<graphicData>
			<texPath>Things/Building/HallDoor/HallDoor2x1_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<uiIconPath>Things/Building/HallDoor/HallDoor_MenuIcon_south</uiIconPath>
		<useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
		<size>(2, 1)</size>
		<rotatable>true</rotatable>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<costStuffCount>75</costStuffCount>
		<building>
			<blueprintClass>Blueprint_Build</blueprintClass>
			<blueprintGraphicData>
				<texPath>Things/Building/HallDoor/HallDoor_MenuIcon</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<shaderType>EdgeDetect</shaderType>
				<drawSize>(2.6, 2.8)</drawSize>
			</blueprintGraphicData>
			<isSupportDoor>true</isSupportDoor>
			<doorTopGraphic>
				<texPath>Things/Building/HallDoor/HallDoor2x1_Top</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<drawSize>(3.1, 2.1)</drawSize>
			</doorTopGraphic>
			<doorSupportGraphic>
				<texPath>Things/Building/HallDoor/HallDoor2x1_Support</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<drawSize>(3.1, 2.1)</drawSize>
			</doorSupportGraphic>
		</building>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationHotKey>Misc3</designationHotKey>
		<placeWorkers>
			<li>PlaceWorker_MultiCellDoor</li>
		</placeWorkers>
	</ThingDef>


	<ThingDef ParentName="DoorBase">
		<defName>DV_HallDoorTimber</defName>
		<label>timber hall door</label>
		<description>Divides rooms. A rustic wooden door decorated in a dwarven style. This large, heavy door requires adjacent walls to function.</description>
		<thingClass>Building_MultiTileDoor</thingClass>
		<dominantStyleCategory>DV_Dwarven</dominantStyleCategory>
		<canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
		<statBases>
			<WorkToBuild>15000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Beauty>30</Beauty>
		</statBases>
		<graphicData>
			<texPath>Things/Building/HallDoor/HallDoorWooden2x1_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<stuffCategories>
			<li>Stony</li>
			<li>Metallic</li>
		</stuffCategories>
		<uiIconPath>Things/Building/HallDoor/HallDoorWooden_MenuIcon_south</uiIconPath>
		<useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
		<size>(2, 1)</size>
		<rotatable>true</rotatable>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<costStuffCount>75</costStuffCount>
		<building>
			<blueprintClass>Blueprint_Build</blueprintClass>
			<blueprintGraphicData>
				<texPath>Things/Building/HallDoor/HallDoorWooden_MenuIcon</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<shaderType>EdgeDetect</shaderType>
				<drawSize>(2.6, 2.8)</drawSize>
			</blueprintGraphicData>
			<isSupportDoor>true</isSupportDoor>
			<doorTopGraphic>
				<texPath>Things/Building/HallDoor/HallDoor2x1_Top</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<drawSize>(3.1, 2.1)</drawSize>
			</doorTopGraphic>
			<doorSupportGraphic>
				<texPath>Things/Building/HallDoor/HallDoor2x1_Support</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<drawSize>(3.1, 2.1)</drawSize>
			</doorSupportGraphic>
		</building>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationHotKey>Misc3</designationHotKey>
		<placeWorkers>
			<li>PlaceWorker_MultiCellDoor</li>
		</placeWorkers>
	</ThingDef>


</Defs>